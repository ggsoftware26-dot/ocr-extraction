# Copy to project root as .env on the server:
#   cp deploy/vps/.env.example .env

# Public hostname (must resolve to this server for Let's Encrypt).
DOMAIN=ocr.example.com

PORT=3000

API_KEY=

# Set by docker-compose.prod.yml; do not point at localhost on the server.
REDIS_HOST=redis
REDIS_PORT=6379

# Cloudflare R2 (S3-compatible). Create the bucket in the Cloudflare dashboard first.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Use us-east-1 for R2 (works with Cloudflare; "auto" is mapped internally too).
S3_REGION=us-east-1
S3_ACCESS_KEY=your_r2_access_key_id
S3_SECRET_KEY=your_r2_secret_access_key
S3_BUCKET=ocr-extraction
S3_FORCE_PATH_STYLE=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

WORKER_CONCURRENCY=4
PDF_PAGE_THRESHOLD=15
PDF_PAGE_BATCH_SIZE=10
PDF_BATCH_CONCURRENCY=2
EXTRACT_TIMEOUT_MS=60000
MAX_FILE_BYTES=52428800
