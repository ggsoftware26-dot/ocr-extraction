PORT=3000

API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Required for local MinIO and Cloudflare R2.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ocr-extraction
S3_FORCE_PATH_STYLE=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Paid-tier estimate used for meta.cost_usd in stored results (USD per 1M tokens).
GEMINI_INPUT_PRICE_PER_1M=0.30
GEMINI_OUTPUT_PRICE_PER_1M=2.50

# Default when job omits provider= (gemini | qwen)
OCR_PROVIDER=gemini

# Self-hosted Qwen2.5-VL via OpenAI-compatible API (Ollama / vLLM / LM Studio)
# Local Mac: ollama pull qwen2.5vl:7b
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen2.5vl:7b
QWEN_API_KEY=ollama

WORKER_CONCURRENCY=4
PDF_PAGE_THRESHOLD=15
PDF_PAGE_BATCH_SIZE=10
PDF_BATCH_CONCURRENCY=2
EXTRACT_TIMEOUT_MS=60000
MAX_FILE_BYTES=52428800

# Ingest service (IMAP → OCR)
INGEST_PORT=3001
INGEST_PUBLIC_URL=http://localhost:3001
IMAP_ENABLED=true

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Persistent IDLE (near-realtime); reconnect backoff after drops / OVERQUOTA
IMAP_RECONNECT_DELAY_MS=30000
# How long to wait in IDLE before a catch-up scan (Gmail EXISTS is unreliable)
IMAP_MAX_IDLE_MS=60000
# Only unseen mail from the last N days on first drain (IMAP SINCE). 0 = all unseen
IMAP_SINCE_DAYS=7
IMAP_MARK_SEEN=true
IMAP_FILTER_SUBJECT=invoice,receipt
IMAP_FILTER_FROM=

OCR_API_URL=http://localhost:3000
OCR_API_KEY=

IMAP_PROCESSED_STORE_PATH=./data/imap-processed.json

# Email OCR results back to the monitored mailbox (uses same Gmail app password)
INGEST_NOTIFY_ENABLED=true
INGEST_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=15000
