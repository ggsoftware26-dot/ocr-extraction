PORT=3000

API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Required for local MinIO and Cloudflare R2.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ocr-extraction
S3_FORCE_PATH_STYLE=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

WORKER_CONCURRENCY=4
PDF_PAGE_THRESHOLD=15
PDF_PAGE_BATCH_SIZE=10
PDF_BATCH_CONCURRENCY=2
EXTRACT_TIMEOUT_MS=60000
MAX_FILE_BYTES=52428800

# Ingest service (IMAP → OCR)
INGEST_PORT=3001
INGEST_PUBLIC_URL=http://localhost:3001
IMAP_ENABLED=true

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_MS=60000
IMAP_MARK_SEEN=true
IMAP_FILTER_SUBJECT=invoice,receipt
IMAP_FILTER_FROM=

OCR_API_URL=http://localhost:3000
OCR_API_KEY=

IMAP_PROCESSED_STORE_PATH=./data/imap-processed.json

# Email OCR results back to the monitored mailbox (uses same Gmail app password)
INGEST_NOTIFY_ENABLED=true
INGEST_NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_CONNECTION_TIMEOUT_MS=15000
